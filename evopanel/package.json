{
  "name": "gogo",
  "version": "1.0.1",
  "private": true,
  "description": "GoGo — 用AI帮你干活的工作平台",
  "main": "electron/main.js",
  "author": "CharonZou",
  "license": "SEE LICENSE IN ../LICENSE",
  "homepage": "https://www.charonzou.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CharonZou/gogo.git"
  },
  "bugs": {
    "url": "https://github.com/CharonZou/gogo/issues"
  },
  "keywords": [
    "evopanel",
    "ai-agent",
    "tauri",
    "desktop-app",
    "management-panel"
  ],
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:1421 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:electron:win": "npm run build && electron-builder --win",
    "build:electron:mac": "npm run build && electron-builder --mac",
    "build:electron:linux": "npm run build && electron-builder --linux",
    "build:desktop:win": "npm run build:electron:win",
    "build:desktop:mac": "bash ./scripts/build-installer-mac.sh",
    "build:debug": "node scripts/run-platform-script.js build --debug",
    "build:clean": "node scripts/run-platform-script.js build --clean",
    "package": "node scripts/run-platform-script.js package",
    "package:exe": "node scripts/run-platform-script.js package --exe-only",
    "package:all": "node scripts/run-platform-script.js package --both",
    "serve": "node scripts/serve.js",
    "serve:win": "powershell -ExecutionPolicy Bypass -File ./scripts/serve.ps1",
    "preview": "vite preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "icon:round": "python scripts/round-app-icon.py docs/assets/gogo-app-icon-square.png docs/assets/gogo-app-icon.png",
    "icon:regen": "npm run icon:round && node ./node_modules/@tauri-apps/cli/tauri.js icon docs/assets/gogo-app-icon.png -o src-tauri/icons",
    "icon:generate": "npm run icon:regen && node -e \"require('fs').copyFileSync('src-tauri/icons/icon.ico','public/favicon.ico')\"",
    "version": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js",
    "version:set": "node scripts/sync-version.js",
    "version:from-git": "node scripts/sync-version.js --from-git",
    "prebuild:desktop:win": "node scripts/sync-version.js && node scripts/download-kws-model.js && node scripts/ensure-kws-bundle.js",
    "prebuild:desktop:mac": "node scripts/sync-version.js && node scripts/download-kws-model.js && node scripts/ensure-kws-bundle.js",
    "kws:download": "node scripts/download-kws-model.js",
    "kws:ensure": "node scripts/ensure-kws-bundle.js",
    "test": "vitest run",
    "test:perf": "vitest run tests/client-perf.test.js tests/client-perf-scenarios.test.js tests/live-stream-path.test.js",
    "verify:perf": "node scripts/verify-perf.mjs",
    "verify:perf:stress": "node scripts/verify-perf.mjs --stress",
    "verify:perf:browser": "playwright test e2e/stream-perf.spec.js",
    "verify:perf:offline": "node scripts/verify-perf.mjs --offline",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "deps:ci": "npm ci --progress=true --loglevel verbose"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.57",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mermaid-js/parser": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-notification": "~2.3.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.1",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "~2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001784",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.8.9",
    "istanbul-lib-coverage": "^3.2.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.2",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "build": {
    "appId": "com.charonzou.gogo",
    "productName": "gogo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src-tauri/binaries/gogo-gateway",
        "to": "gogo-gateway",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/logo.png",
      "artifactName": "gogo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "public/images/logo.ico",
      "uninstallerIcon": "public/images/logo.ico",
      "installerHeaderIcon": "public/images/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "gogo",
      "displayLanguageSelector": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/images/logo.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/images/logo.png",
      "category": "Office"
    }
  }
}
